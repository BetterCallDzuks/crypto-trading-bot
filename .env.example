# ===========================================================================
#  Crypto Trading Bot — environment configuration
#  Copy this file to `.env` and fill in the values you need.
#  NOTHING here is required to run in paper-trading mode.
# ===========================================================================

# --- Trading mode ----------------------------------------------------------
# "paper" = simulated money (default, SAFE). "live" = real orders on exchange.
# Live mode ALSO requires TRADING_LIVE_CONFIRM=I_UNDERSTAND_THE_RISK below.
TRADING_MODE=paper

# Extra guard rail. Live orders are refused unless this is set to the exact
# phrase below. This makes it impossible to go live by accident.
TRADING_LIVE_CONFIRM=

# --- Exchange --------------------------------------------------------------
# Any ccxt-supported exchange id, e.g. binance, bybit, coinbase, kraken, okx.
EXCHANGE_ID=binance

# Market type: "spot" (no leverage, no liquidation) or "swap" (perpetual futures).
MARKET_TYPE=spot

# API credentials — ONLY needed for live trading. Leave blank for paper mode.
# Create keys with TRADE permission only. NEVER enable withdrawals.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (okx, kucoin, coinbase) also need a passphrase:
EXCHANGE_API_PASSWORD=

# Use the exchange sandbox / testnet if it offers one (recommended first step).
EXCHANGE_SANDBOX=false

# --- Dashboard -------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Set a token to require ?token=... (or Authorization header) on the dashboard.
# Strongly recommended if the dashboard is reachable from the internet.
DASHBOARD_TOKEN=
